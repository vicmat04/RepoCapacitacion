# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Force LF for these files
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.mjs   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.sql   text eol=lf
*.env*  text eol=lf

# Binary files
*.ico   binary
*.png   binary
*.jpg   binary
*.svg   text eol=lf
