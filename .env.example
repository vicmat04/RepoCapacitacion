# ============================================================
# FACILITADORES CONTROL CENTER — Environment Variables Template
# Copiar a .env.local y completar con los valores reales de Supabase
# NUNCA commitear .env.local al repositorio
# ============================================================

# ============================================================
# SUPABASE — Obtener desde: supabase.com → Project Settings → API
# ============================================================

# URL del proyecto (seguro para el browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon key (seguro para el browser — RLS protege los datos)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key (SOLO SERVER — bypasea RLS — NUNCA exponer al browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# APP
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Facilitadores Control Center"
